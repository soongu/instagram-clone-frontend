# 세션 쿠키에 붙는 서명을 만드는 열쇠. 서버만 알아야 한다.
# 이 파일을 .env.local 로 복사한 뒤 아래 값을 직접 만든 것으로 바꾼다.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=여기에-직접-만든-값을-넣으세요

# 인증 서버가 자기 주소를 알아야 콜백과 되돌리기가 제대로 동작한다.
BETTER_AUTH_URL=http://localhost:3000

# 소셜 로그인 열쇠. GitHub 에 앱을 등록하면 나온다.
# 없어도 앱은 뜬다 — 강의용 가짜 값으로 떨어지고, 보낼 주소까지는 그대로 만들어진다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 백엔드가 "이 사람 정보가 바뀌었다" 고 알려올 때 함께 내미는 값.
# 우리 서버와 백엔드만 알아야 한다 — 브라우저로 나가면 안 된다.
#   openssl rand -base64 32
REVALIDATE_SECRET=여기에-직접-만든-값을-넣으세요
